---
import {
  SiAstro,
  SiCss,
  SiExpress,
  SiGit,
  SiMongodb,
  SiNextdotjs,
  SiNodedotjs,
  SiReact,
  SiTypescript,
} from "react-icons/si";

import IconWrapper from "./IconWrapper";

const skills = [
  { name: "React", color: "#61DAFB", icon: SiReact },
  { name: "MongoDB", color: "#47A248", icon: SiMongodb },
  { name: "Astro", color: "#FF5D01", icon: SiAstro },
  { name: "TypeScript", color: "#3178C6", icon: SiTypescript },
  { name: "Node.js", color: "#339933", icon: SiNodedotjs },
  { name: "Next.js", color: "#ffffff", icon: SiNextdotjs },
  { name: "CSS/SCSS", color: "#1572B6", icon: SiCss },
  { name: "Git", color: "#F05032", icon: SiGit },
  { name: "Express", color: "#ffffff", icon: SiExpress },
];

const highlights = [
  "Design and build reusable React interfaces with clean state, component and routing patterns.",
  "Ship fast Astro and SPA experiences with responsive layouts, accessibility and SEO in mind.",
  "Connect products to APIs, authentication, databases and third-party services with reliable UX.",
];
---

<section
  id="tecnologias"
  class="scroll-mt-24 bg-[#0f141f] px-4 py-16 font-Montserrat sm:px-6 sm:py-20 lg:px-8 lg:py-24"
>
  <div class="mx-auto max-w-7xl">
    <div
      class="grid items-center gap-10 lg:grid-cols-[0.95fr,1.05fr] lg:gap-16"
    >
      <div class="order-2 lg:order-1">
        <div class="relative mx-auto max-w-xl">
          <lottie-player
            src="/images/codingPerson.json"
            background="transparent"
            speed="1"
            loop
            autoplay
            class="block w-full aspect-[4/3]"></lottie-player>
        </div>
      </div>

      <div class="order-1 lg:order-2">
        <p class="section-eyebrow">Capabilities</p>
        <h2 class="section-title mt-3">Engineering that makes interfaces feel effortless.</h2>
        <p class="section-copy mt-6">
          I combine thoughtful UI craft with practical frontend architecture:
          typed components, API-driven data, responsive systems and production
          performance.
        </p>

        <div
          class="mb-10 mt-10 grid grid-cols-[repeat(auto-fit,minmax(72px,1fr))] gap-x-4 gap-y-7 sm:mb-12 sm:grid-cols-[repeat(auto-fit,minmax(90px,1fr))] sm:gap-x-6 sm:gap-y-8"
        >
          {
            skills.map((skill) => (
              <div class="group flex flex-col items-center">
                <div
                  class="skill-icon text-4xl text-slate-400 transition-all duration-300 group-hover:scale-110 sm:text-5xl"
                  style={`--skill-accent: ${skill.color};`}
                >
                  <IconWrapper Icon={skill.icon} />
                </div>
                <h3 class="mt-3 text-center text-[0.65rem] text-slate-500 transition-colors group-hover:text-slate-300 sm:text-xs">
                  {skill.name}
                </h3>
              </div>
            ))
          }
        </div>

        <div class="space-y-4 sm:space-y-5">
          {
            highlights.map((item) => (
              <p class="glass-panel flex gap-3 rounded-lg px-4 py-3 text-sm text-white sm:text-base">
                <span class="mt-1 h-2 w-2 shrink-0 rounded-full bg-[#9ae6b4]"></span>
                <span>{item}</span>
              </p>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>

<script
  src="https://unpkg.com/@lottiefiles/lottie-player@latest/dist/lottie-player.js"
></script>

<style>
  .group:hover .skill-icon {
    color: var(--skill-accent);
  }
</style>
