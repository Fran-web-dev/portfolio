---
const principles = [
  {
    label: "01",
    title: "Clarity before decoration",
    description:
      "Interfaces are designed around what the user needs to understand, decide and do next.",
  },
  {
    label: "02",
    title: "Motion with purpose",
    description:
      "Interactions are quiet, fast and intentional, supporting focus instead of stealing it.",
  },
  {
    label: "03",
    title: "Systems that can grow",
    description:
      "Components, spacing, states and data flows are structured so products stay maintainable.",
  },
];

const signals = [
  "Accessible UI",
  "Typed components",
  "API-ready flows",
  "Responsive systems",
];
---

<section
  id="studio"
  class="relative overflow-hidden bg-[#0b1019] px-4 py-16 sm:px-6 sm:py-20 lg:px-8 lg:py-24"
>
  <div class="studio-grid pointer-events-none absolute inset-0 opacity-45"></div>

  <div class="relative mx-auto max-w-7xl">
    <div class="grid gap-10 lg:grid-cols-[0.92fr,1.08fr] lg:gap-14">
      <div>
        <p class="section-eyebrow">Creative direction</p>
        <h2 class="section-title mt-3">
          A portfolio with a product-engineering signature.
        </h2>
        <p class="section-copy mt-6">
          The goal is not to look like every developer template. This portfolio
          presents a calm, premium interface language: focused content, elegant
          motion, live data and a clear engineering point of view.
        </p>

        <div class="mt-8 grid gap-3 sm:grid-cols-2">
          {
            signals.map((signal) => (
              <div class="signal-pill">
                <span></span>
                {signal}
              </div>
            ))
          }
        </div>
      </div>

      <div class="studio-panel glass-panel rounded-lg p-4 sm:p-6">
        <div class="mb-6 flex items-center justify-between border-b border-white/10 pb-4">
          <div>
            <p class="text-sm font-semibold text-white">Interface Studio</p>
            <p class="mt-1 text-xs text-slate-400">Design x Frontend x Product</p>
          </div>
          <div class="flex gap-2">
            <span class="h-2.5 w-2.5 rounded-full bg-[#fda4af]"></span>
            <span class="h-2.5 w-2.5 rounded-full bg-[#fde68a]"></span>
            <span class="h-2.5 w-2.5 rounded-full bg-[#9ae6b4]"></span>
          </div>
        </div>

        <div class="grid gap-4">
          {
            principles.map((item) => (
              <article class="studio-card">
                <span class="text-sm font-semibold text-[#7dd3fc]">{item.label}</span>
                <div>
                  <h3 class="text-lg font-semibold text-white">{item.title}</h3>
                  <p class="mt-2 text-sm leading-7 text-slate-300">
                    {item.description}
                  </p>
                </div>
              </article>
            ))
          }
        </div>

        <div class="mt-5 rounded-lg border border-white/10 bg-[#07111f]/80 p-4">
          <div class="flex items-center justify-between gap-3 text-xs uppercase tracking-[0.24em] text-slate-500">
            <span>Build signal</span>
            <span>Production-ready</span>
          </div>
          <div class="mt-4 grid grid-cols-12 gap-1">
            {
              Array.from({ length: 24 }).map((_, index) => (
                <span
                  class="signal-bar"
                  style={`--bar-delay: ${index * 80}ms; --bar-height: ${
                    28 + ((index * 17) % 44)
                  }%;`}
                ></span>
              ))
            }
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .studio-grid {
    background-image:
      linear-gradient(rgba(125, 211, 252, 0.08) 1px, transparent 1px),
      linear-gradient(90deg, rgba(125, 211, 252, 0.08) 1px, transparent 1px);
    background-size: 44px 44px;
    mask-image: radial-gradient(circle at 50% 45%, black, transparent 70%);
  }

  .signal-pill {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    min-height: 3rem;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 0.5rem;
    background: rgba(255, 255, 255, 0.045);
    padding: 0.75rem 0.9rem;
    color: #dbeafe;
    font-size: 0.875rem;
  }

  .signal-pill span {
    width: 0.55rem;
    height: 0.55rem;
    border-radius: 999px;
    background: #9ae6b4;
    box-shadow: 0 0 18px rgba(154, 230, 180, 0.6);
  }

  .studio-panel {
    position: relative;
  }

  .studio-panel::before {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: inherit;
    pointer-events: none;
    background: linear-gradient(135deg, rgba(125, 211, 252, 0.18), transparent 35%, rgba(154, 230, 180, 0.12));
    opacity: 0.55;
  }

  .studio-panel > * {
    position: relative;
  }

  .studio-card {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 1rem;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 0.5rem;
    background: rgba(7, 17, 31, 0.72);
    padding: 1rem;
    transition:
      transform 240ms ease,
      border-color 240ms ease,
      background 240ms ease;
  }

  .studio-card:hover {
    transform: translateY(-3px);
    border-color: rgba(125, 211, 252, 0.42);
    background: rgba(15, 23, 42, 0.9);
  }

  .signal-bar {
    height: 4.5rem;
    border-radius: 999px;
    background: linear-gradient(to top, rgba(125, 211, 252, 0.14), rgba(125, 211, 252, 0.78));
    transform-origin: bottom;
    transform: scaleY(var(--bar-height));
    animation: studioPulse 2.8s ease-in-out infinite;
    animation-delay: var(--bar-delay);
  }

  @keyframes studioPulse {
    0%,
    100% {
      opacity: 0.42;
      filter: saturate(0.8);
    }

    50% {
      opacity: 1;
      filter: saturate(1.25);
    }
  }
</style>
