---
const links = [
  { label: "Studio", href: "#studio" },
  { label: "Skills", href: "#tecnologias" },
  { label: "Projects", href: "#proyectos" },
  { label: "Experience", href: "#experiencia" },
  { label: "GitHub", href: "#github" },
  { label: "Resume", href: "/downloads/Franklin_Villanueva_Resume.pdf" },
  { label: "Contact", href: "#contacto" },
];
---

<header
  class="sticky top-0 z-50 border-b border-white/10 bg-[#0b1019]/82 backdrop-blur-xl"
>
  <div
    class="mx-auto flex max-w-7xl items-center gap-3 px-4 py-4 sm:gap-6 sm:px-6 lg:px-8"
  >
    <a
      href="#inicio"
      class="flex shrink-0 items-center gap-3 text-lg font-semibold tracking-tight text-white transition-opacity hover:opacity-90"
      aria-label="Go to top"
    >
      <span class="flex h-9 w-9 items-center justify-center rounded-md border border-[#7dd3fc]/30 bg-[#7dd3fc]/10 text-sm text-[#7dd3fc]">FV</span>
      <span class="hidden sm:inline">Franklin Villanueva</span>
      <span class="sm:hidden">Frank</span>
    </a>

    <nav aria-label="Primary navigation" class="ml-auto min-w-0 flex-1 overflow-hidden">
      <ul
        class="flex max-w-full items-center gap-1 overflow-x-auto whitespace-nowrap text-xs text-slate-200 sm:gap-3 sm:text-sm lg:gap-6"
      >
        {
          links.map((link) => (
            <li class="shrink-0">
              <a
                href={link.href}
                class:list={[
                  "inline-flex items-center rounded-full px-3 py-2 transition-colors duration-300 hover:bg-white/10 hover:text-white",
                  link.label === "Resume" &&
                    "border border-[#7dd3fc]/35 bg-[#7dd3fc]/10 text-[#dff7ff] hover:bg-[#7dd3fc]/20",
                ]}
              >
                {link.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<style>
  header::-webkit-scrollbar {
    display: none;
  }

  header {
    scrollbar-width: none;
  }
</style>
