---
const strengths = [
  "Product-minded UI engineering",
  "Accessible React architecture",
  "Performance-focused Astro builds",
  "API integration and data workflows",
];
---

<section
  id="inicio"
  class="relative overflow-hidden px-4 py-16 sm:px-6 sm:py-20 lg:px-8 lg:py-24"
>
  <div class="mx-auto grid max-w-7xl items-center gap-12 lg:grid-cols-[1.08fr,0.92fr]">
    <div>
      <p class="section-eyebrow">Frontend Developer | React | Astro | Node.js</p>
      <h1 class="mt-5 text-[clamp(2.8rem,7vw,5.8rem)] font-semibold leading-[0.94] tracking-normal text-white">
        Senior-level interfaces with speed, taste and clarity.
      </h1>
      <p class="section-copy mt-7">
        I am Franklin Villanueva, a frontend developer building responsive,
        accessible and polished web products. I turn product ideas into clean
        interfaces, scalable component systems and fast user experiences.
      </p>

      <div class="mt-8 flex flex-col gap-3 sm:flex-row sm:flex-wrap">
        <a href="#github" class="professional-button professional-button--primary">
          View live work
        </a>
        <a href="#contacto" class="professional-button professional-button--ghost">
          Contact me
        </a>
        <a
          href="/downloads/Franklin_Villanueva_Resume.pdf"
          download="Franklin_Villanueva_Resume.pdf"
          class="professional-button professional-button--ghost"
        >
          Download resume
        </a>
      </div>

      <div class="mt-10 grid gap-3 sm:grid-cols-2">
        {
          strengths.map((item) => (
            <div class="glass-panel rounded-lg px-4 py-3 text-sm text-slate-200">
              {item}
            </div>
          ))
        }
      </div>

      <div class="mt-8 flex flex-col gap-3 border-l border-[#7dd3fc]/40 pl-4 text-sm text-slate-300 sm:flex-row sm:items-center sm:gap-6">
        <span class="inline-flex items-center gap-2">
          <span class="h-2 w-2 rounded-full bg-[#9ae6b4] shadow-[0_0_18px_rgba(154,230,180,0.7)]"></span>
          Open to frontend roles
        </span>
        <span>Remote-first collaboration</span>
        <span>Clean UI, real APIs, fast delivery</span>
      </div>
    </div>

    <div class="relative">
      <div class="glass-panel relative overflow-hidden rounded-lg p-3">
        <img
          src="/images/profile.png"
          alt="Franklin Villanueva"
          class="aspect-[4/5] w-full rounded-md object-cover"
          loading="eager"
        />
        <div class="absolute inset-x-3 bottom-3 rounded-b-md bg-gradient-to-t from-[#07111f]/95 via-[#07111f]/62 to-transparent p-5">
          <p class="section-eyebrow text-[0.65rem]">Available for remote teams</p>
          <p class="mt-2 text-2xl font-semibold text-white">LATAM | Global</p>
        </div>
      </div>

      <div class="glass-panel absolute -bottom-6 left-4 right-4 rounded-lg p-5 sm:left-auto sm:right-8 sm:w-72">
        <p class="text-sm text-slate-400">Current focus</p>
        <p class="mt-2 text-lg font-semibold text-white">
          Building elegant React products with measurable performance.
        </p>
      </div>
    </div>
  </div>
</section>
