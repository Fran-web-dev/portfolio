---
const projects = [
  {
    title: "EdgeMetrics Command Center",
    subtitle: "Real-time observability dashboard",
    description:
      "A production-style analytics workspace for monitoring API latency, error budgets and deployment health across regions.",
    impact: "Recruiter signal: systems thinking, data UX, reliability metrics",
    stack: ["React", "TypeScript", "Node.js", "WebSockets", "PostgreSQL"],
    metrics: ["P95 latency views", "SLO burn alerts", "Live incident timeline"],
    href: "/projects/edge-metrics-command-center/",
  },
  {
    title: "TalentFlow ATS",
    subtitle: "Applicant tracking system",
    description:
      "A hiring workflow platform for managing candidates, job openings and recruiter pipelines with a clean operational interface.",
    impact:
      "Recruiter signal: product UX, authenticated flows, business workflow design",
    stack: ["React", "TypeScript", "Tailwind CSS", "Netlify", "Authentication"],
    metrics: ["Candidate pipeline", "Job tracking", "Recruiter dashboard"],
    href: "https://talentflowatss.netlify.app/login",
    cta: "View live project",
    external: true,
  },
  {
    title: "PulseCart Infrastructure Lab",
    subtitle: "Scalable commerce backend",
    description:
      "A backend architecture case study for checkout, inventory and payments with queues, caching and graceful failure handling.",
    impact:
      "Recruiter signal: backend fundamentals, distributed flows, API design",
    stack: ["Node.js", "Express", "MongoDB", "Queues", "Docker"],
    metrics: ["Idempotent checkout", "Inventory locks", "Retry-safe webhooks"],
    href: "/projects/pulsecart-infrastructure-lab/",
  },
];
---

<section
  id="proyectos"
  class="scroll-mt-24 bg-[#0b1019] px-4 py-16 sm:px-6 sm:py-20 lg:px-8 lg:py-24"
>
  <div class="mx-auto max-w-7xl">
    <div class="mb-12 max-w-3xl">
      Some of my best personal projects
      <p class="section-eyebrow">Selected Projects</p>
      <h2 class="section-title mt-3">Projects</h2>
      <p class="section-copy mt-6">
        Some of my best personal projects, built with a product-minded approach,
        focusing on clarity, speed and polish.
      </p>
    </div>

    <div class="grid gap-5 lg:grid-cols-3">
      {
        projects.map((project) => (
          <article class="project-card flex min-h-[34rem] flex-col p-6 sm:p-7">
            <div class="mb-6">
              <p class="text-sm font-semibold text-[#9ae6b4]">
                {project.subtitle}
              </p>
              <h3 class="mt-3 text-2xl font-semibold leading-tight text-white">
                {project.title}
              </h3>
              <p class="mt-4 text-sm leading-7 text-slate-300">
                {project.description}
              </p>
            </div>

            <div class="rounded-lg border border-white/10 bg-[#111827]/80 p-4">
              <p class="text-xs font-semibold uppercase tracking-[0.22em] text-[#7dd3fc]">
                Focus
              </p>
              <p class="mt-3 text-sm leading-6 text-slate-300">
                {project.impact}
              </p>
            </div>

            <div class="mt-6">
              <p class="text-xs font-semibold uppercase tracking-[0.22em] text-slate-500">
                Architecture Signals
              </p>
              <ul class="mt-4 space-y-3">
                {project.metrics.map((metric) => (
                  <li class="flex items-start gap-3 text-sm text-slate-300">
                    <span class="mt-2 h-2 w-2 shrink-0 rounded-full bg-[#7dd3fc]" />
                    <span>{metric}</span>
                  </li>
                ))}
              </ul>
            </div>

            <div class="mt-6 flex flex-wrap gap-2">
              {project.stack.map((item) => (
                <span class="rounded-md border border-white/10 bg-white/[0.04] px-3 py-2 text-xs text-slate-300">
                  {item}
                </span>
              ))}
            </div>

            <a
              href={project.href}
              target={project.external ? "_blank" : undefined}
              rel={project.external ? "noopener noreferrer" : undefined}
              class="professional-button professional-button--ghost mt-auto"
            >
              {project.cta ?? "View project brief"}
            </a>
          </article>
        ))
      }
    </div>
  </div>
</section>
